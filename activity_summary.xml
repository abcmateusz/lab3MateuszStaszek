<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/textKlient"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="klient"
        android:textSize="20sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="100dp" />

    <TextView
        android:id="@+id/textRozmiar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="rozmiar"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/textKlient"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

    <TextView
        android:id="@+id/textSer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="dodatkowy ser"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/textRozmiar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

    <Button
        android:id="@+id/buttonPowrot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="wroc"
        app:layout_constraintTop_toBottomOf="@id/textSer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="30dp" />

</androidx.constraintlayout.widget.ConstraintLayout>

